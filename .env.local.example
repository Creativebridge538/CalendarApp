# `supabase start` 実行後、`supabase status` の出力から値を埋めること。
# ローカル開発用のデモキーは固定値（全ローカル環境共通、秘密情報ではない）。

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# `supabase db push --linked` 実行時のみ必要（リモートDBのパスワード）
SUPABASE_DB_PASSWORD=

# Web Push通知用（任意で `web-push generate-vapid-keys` などで生成）
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:example@example.com

# 報酬確定通知メール送信用（任意。未設定時は送信をスキップする）
RESEND_API_KEY=
